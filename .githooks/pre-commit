#!/bin/sh
# Keep RED-family claim-level analysis out of version control.
#
# docs/ip/.gitignore stops the ordinary accident -- `git add -A` sweeping up a
# claim chart. This hook covers the two cases a .gitignore cannot: `git add -f`,
# and claim-level text inside a file that is allowed to be tracked.
#
# WHY THE GUARD IS LOOKED UP IN TWO PLACES
#   Worktrees check out different branches, and a branch that predates the guard
#   has no scripts/ip_privilege_guard.py -- which is precisely the branch the
#   privileged files sit on today. Hooks live in the git COMMON directory and so
#   are shared by every worktree, so a copy of the guard goes there too. The
#   tracked copy wins when present; the common-dir copy is what makes the hook
#   mean anything on a branch that has not merged it yet.
#
# A missing guard is a failed commit, not a permitted one. Fail closed -- a
# control that disappears quietly is worse than no control, because the absence
# looks like a pass.
#
# Install (per clone; hooks are not themselves version controlled):
#   git config core.hooksPath .githooks
# or, to protect every worktree regardless of the branch checked out:
#   cp .githooks/pre-commit "$(git rev-parse --git-common-dir)/hooks/pre-commit"
#   cp scripts/ip_privilege_guard.py "$(git rev-parse --git-common-dir)/ip-privilege-guard.py"

set -e

TOPLEVEL=$(git rev-parse --show-toplevel)
COMMON=$(git rev-parse --git-common-dir)
case "$COMMON" in
  /*|[A-Za-z]:*) ;;
  *) COMMON="$TOPLEVEL/$COMMON" ;;
esac

GUARD="$TOPLEVEL/scripts/ip_privilege_guard.py"
[ -f "$GUARD" ] || GUARD="$COMMON/ip-privilege-guard.py"

if [ ! -f "$GUARD" ]; then
  echo "pre-commit: IP privilege guard not found." >&2
  echo "  looked in scripts/ip_privilege_guard.py and $COMMON/ip-privilege-guard.py" >&2
  echo "  Refusing the commit: an absent guard is not a passing guard." >&2
  exit 1
fi

# WHY THE INTERPRETER IS SEARCHED FOR RATHER THAN NAMED
#   Git Bash on Windows carries neither `python` nor `python3` on its PATH, so
#   naming them was the same as having no guard at all -- every commit from that
#   shell died here, and the tempting way out is --no-verify, which is exactly
#   the escape this hook exists to close. The repository's own .venv is tried
#   first because it is the one interpreter a clone is guaranteed to have set up;
#   `py` comes last because the Windows launcher needs an argument to pick a
#   version and so cannot be treated like the others.
#
#   Each candidate is EXECUTED, not merely located. `command -v python` succeeds
#   on a stock Windows against a Microsoft Store stub that then refuses to run,
#   which would turn a fail-closed control into a confusing failure at the wrong
#   line. The probe also asserts Python 3: the guard's `from __future__ import
#   annotations` would not survive a Python 2 that happened to answer first.
#
#   The guard imports only the standard library, so any working Python 3 runs it
#   correctly; the ordering below is about reliability, not compatibility.

PY=""
PYARG=""
for candidate in \
  "$TOPLEVEL/.venv/Scripts/python.exe" \
  "$TOPLEVEL/.venv/bin/python" \
  python3 \
  python
do
  if "$candidate" -c "import sys; sys.exit(0 if sys.version_info[0] >= 3 else 1)" \
      >/dev/null 2>&1; then
    PY="$candidate"
    break
  fi
done

if [ -z "$PY" ] && py -3 -c "import sys" >/dev/null 2>&1; then
  PY=py
  PYARG=-3
fi

if [ -z "$PY" ]; then
  echo "pre-commit: no working python 3; cannot run the IP privilege guard." >&2
  echo "  tried .venv/Scripts/python.exe, .venv/bin/python, python3, python, py -3" >&2
  echo "  Refusing the commit: a guard that cannot run is not a passing guard." >&2
  exit 1
fi

if [ -n "$PYARG" ]; then
  exec "$PY" "$PYARG" "$GUARD" --staged
fi
exec "$PY" "$GUARD" --staged
