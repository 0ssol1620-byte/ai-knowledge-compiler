{
  "name": "@akc/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test --config=playwright.live.config.ts",
    "interactions:check": "node scripts/verify-button-contracts.mjs",
    "blueprint:check": "node scripts/verify-blueprint.mjs",
    "claims:check": "node scripts/verify-claims.mjs",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "lighthouse": "lhci autorun --config=./lighthouserc.json"
  },
  "dependencies": {
    "@microsoft/fetch-event-source": "2.0.1",
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-query": "5.101.4",
    "@uiw/react-codemirror": "4.25.11",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "hash-wasm": "4.12.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-virtuoso": "4.18.11",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.62.0",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "impeccable": "3.5.0",
    "jsdom": "30.0.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
