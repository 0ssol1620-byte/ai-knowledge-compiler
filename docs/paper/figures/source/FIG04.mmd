  CRIT -->|no| TIE{"top two within<br/>the tie band?"}
  TIE -->|yes| AMB
  TIE -->|no| BAND{"score band"}
  BAND -->|"≥ merge bar"| M["MATCHED<br/>continues prior identity"]
  BAND -->|"review band"| AMB
  BAND -->|"below floor"| N["NEW identity"]
  AMB --> PROP["No traversal seed ·<br/>not a modification ·<br/>not a removal"]

