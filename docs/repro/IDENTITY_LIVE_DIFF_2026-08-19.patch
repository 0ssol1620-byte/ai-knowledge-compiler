+def _blocked_candidate_columns(
+    incoming: LogicalUnitFingerprint,
+    previous: list[LogicalUnitFingerprint],
+    index: tuple[dict[str, list[int]], dict[str, list[int]], dict[str, list[int]]],
+) -> list[int]:
