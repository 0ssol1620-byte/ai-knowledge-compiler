{
  "$schema": "scale-profile.schema.json",
  "schema_version": "2.0.0",
  "catalog_id": "akc-v4-nonproduction-readiness",
  "masterplan_revision": "Structara v4 KO 2026-07-31",
  "safety": {
    "required_confirmation_env": "AKC_LOAD_CONFIRM",
