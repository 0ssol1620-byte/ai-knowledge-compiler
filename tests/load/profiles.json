      "required_fixture_env": [
        "AKC_TEST_TOKEN",
        "AKC_TEST_PROJECT_ID",
        "AKC_RUN_ID",
        "AKC_10GIB_FIXTURE_MANIFEST",
        "AKC_10GIB_STATE_PATH",
        "AKC_10GIB_OBSERVATION_PATH",
        "AKC_ALLOWED_UPLOAD_ORIGINS",
        "AKC_CLEANUP_ON_SUCCESS"
