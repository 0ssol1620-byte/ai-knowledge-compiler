  "profiles": {
    "collection_manifest_5000": {
      "requirement_refs": ["Wave 1.8", "44.2 5,000 file selection", "44.6 5,000 files"],
      "execution_class": "external_scale",
      "mutates_target": true,
      "runner": "k6",
      "script": "tests/load/k6-collection-manifest.js",
      "command": ["k6", "run", "tests/load/k6-collection-manifest.js"],
      "dimensions": {
        "files": 5000,
        "bytes_per_manifest_entry": 1024,
        "manifest_bytes": 5120000
      },
      "required_fixture_env": ["AKC_TEST_TOKEN", "AKC_TEST_PROJECT_ID", "AKC_RUN_ID"],
      "thresholds": {
        "manifest_plan_p95_ms": 30000,
        "http_failure_rate": 0.01
      },
      "required_evidence_metrics": [
        "manifest_files_observed",
        "manifest_plan_p95_ms",
        "api_peak_rss_bytes",
        "cleanup_completed"
      ],
      "cleanup": "delete_disposable_collection"
    },
