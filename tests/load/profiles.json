        "interrupt": ["node", "tests/load/resume-10gib.mjs", "--phase", "interrupt"],
        "resume": ["node", "tests/load/resume-10gib.mjs", "--phase", "resume"]
      },
      "dimensions": {
        "files": 10,
        "bytes_per_file": 1073741824,
        "total_bytes": 10737418240,
        "interrupt_after_bytes": 5368709120,
        "browser_restart_boundary": true
