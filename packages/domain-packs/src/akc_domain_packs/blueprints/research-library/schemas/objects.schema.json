{
  "blueprint": "research-library",
  "kind": "object-schema",
  "version": "1.0.0",
  "type": "object",
  "required": ["object_kind", "stable_id", "source_refs"],
  "properties": {
    "object_kind": {"enum": ["Paper", "Author", "Method", "Dataset", "Finding", "Citation"]},
    "stable_id": {"type": "string", "minLength": 1},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": true
}
