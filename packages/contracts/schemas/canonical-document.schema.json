{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aiknowledgecompiler.dev/canonical-document/1.0.0",
  "title": "CanonicalDocument",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "tenantId",
    "documentId",
    "documentVersionId",
    "title",
    "sourceFilename",
    "sourceSha256",
    "contentLayer",
    "blocks",
    "modelRuns",
    "metadata",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": "cir-1.0.0" },
    "tenantId": { "$ref": "#/$defs/id" },
    "documentId": { "$ref": "#/$defs/id" },
    "documentVersionId": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1 },
    "sourceFilename": { "type": "string", "minLength": 1 },
    "sourceSha256": { "$ref": "#/$defs/sha256" },
    "contentLayer": { "$ref": "#/$defs/contentLayer" },
    "blocks": {
      "type": "array",
      "items": { "$ref": "#/$defs/block" }
    },
    "modelRuns": { "type": "array", "items": { "type": "object" } },
    "metadata": { "type": "object" },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 3, "maxLength": 256 },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "origin": {
      "enum": [
        "native_extracted",
        "ocr_extracted",
        "rule_reconstructed",
        "ai_reconstructed",
        "ai_summarized",
        "ai_inferred",
        "user_edited"
      ]
    },
    "contentLayer": {
      "enum": ["source", "extracted", "structured", "knowledge", "index"]
    },
    "bbox1000": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": 0, "maximum": 1000 },
        { "type": "integer", "minimum": 0, "maximum": 1000 },
        { "type": "integer", "minimum": 0, "maximum": 1000 },
        { "type": "integer", "minimum": 0, "maximum": 1000 }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4,
      "x-akc-invariant": "x1 < x2 and y1 < y2"
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentId",
        "documentVersionId",
        "pageIndex0",
        "pageNumber1"
      ],
      "properties": {
        "documentId": { "$ref": "#/$defs/id" },
        "documentVersionId": { "$ref": "#/$defs/id" },
        "pageIndex0": { "type": "integer", "minimum": 0 },
        "pageNumber1": { "type": "integer", "minimum": 1 },
        "bbox1000": { "$ref": "#/$defs/bbox1000" },
        "nativeObjectId": { "$ref": "#/$defs/id" },
        "imageAssetId": { "$ref": "#/$defs/id" },
        "timeStartMs": { "type": "integer", "minimum": 0 },
        "timeEndMs": { "type": "integer", "minimum": 0 }
      },
      "x-akc-invariant": "pageNumber1 == pageIndex0 + 1"
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rowIndex0",
        "columnIndex0",
        "rowSpan",
        "columnSpan",
        "rawText",
        "normalizedText",
        "origin",
        "sourceRefs",
        "qualityFlags"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "rowIndex0": { "type": "integer", "minimum": 0 },
        "columnIndex0": { "type": "integer", "minimum": 0 },
        "rowSpan": { "type": "integer", "minimum": 1 },
        "columnSpan": { "type": "integer", "minimum": 1 },
        "rawText": { "type": "string" },
        "normalizedText": { "type": "string" },
        "origin": { "$ref": "#/$defs/origin" },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceRef" }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "qualityFlags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rowCount",
        "columnCount",
        "headerRowCount",
        "cells",
        "sourceRefs",
        "qualityFlags"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "rowCount": { "type": "integer", "minimum": 1 },
        "columnCount": { "type": "integer", "minimum": 1 },
        "headerRowCount": { "type": "integer", "minimum": 0 },
        "cells": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/cell" }
        },
        "caption": { "type": "string" },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceRef" }
        },
        "qualityFlags": { "type": "array", "items": { "type": "string" } }
      },
      "x-akc-invariant": "cell spans are in bounds and do not overlap"
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "type",
        "contentLayer",
        "origin",
        "sourceRefs",
        "modelRunIds",
        "qualityFlags",
        "contentHash",
        "revision"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "parentId": { "$ref": "#/$defs/id" },
        "order": { "type": "integer", "minimum": 0 },
        "type": {
          "enum": [
            "title",
            "heading",
            "paragraph",
            "list",
            "table",
            "figure",
            "caption",
            "formula",
            "code",
            "quote",
            "footnote",
            "header",
            "footer",
            "page_number",
            "unknown"
          ]
        },
        "contentLayer": { "$ref": "#/$defs/contentLayer" },
        "rawText": { "type": "string" },
        "normalizedText": { "type": "string" },
        "markdown": { "type": "string" },
        "sanitizedHtml": { "type": "string" },
        "table": { "$ref": "#/$defs/table" },
        "formulaLatex": { "type": "string" },
        "origin": { "$ref": "#/$defs/origin" },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceRef" }
        },
        "modelRunIds": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "qualityFlags": { "type": "array", "items": { "type": "string" } },
        "contentHash": { "$ref": "#/$defs/sha256" },
        "revision": { "type": "integer", "minimum": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "table" } },
            "required": ["type"]
          },
          "then": { "required": ["table"] }
        },
        {
          "if": {
            "properties": { "type": { "const": "formula" } },
            "required": ["type"]
          },
          "then": { "required": ["formulaLatex"] }
        }
      ]
    }
  }
}
