{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aiknowledgecompiler.dev/route-decision/1.0.0",
  "title": "RouteDecision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "route",
    "routeProfile",
    "reasonCodes",
    "expectedCredits",
    "requiresVisualParse",
    "requireCrossCheck",
    "maxAttempts",
    "policyVersion",
    "providerOptions"
  ],
  "properties": {
    "route": {
      "enum": [
        "native",
        "paddle_vl",
        "paddle_fast",
        "hpd_fast",
        "unlimited_long",
        "mistral_fallback",
        "region_recovery",
        "authority_reconstruction",
        "unresolved",
        "quarantine"
      ]
    },
    "routeProfile": {
      "enum": [
        "parse_fast_v1",
        "parse_balanced_v1",
        "parse_precision_v1",
        "parse_long_v1",
        "parse_private_v1"
      ]
    },
    "reasonCodes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "expectedCredits": { "type": "number", "minimum": 0 },
    "requiresVisualParse": { "type": "boolean" },
    "requireCrossCheck": { "type": "boolean" },
    "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 5 },
    "policyVersion": { "type": "string", "minLength": 1 },
    "providerOptions": { "type": "object" }
  }
}
