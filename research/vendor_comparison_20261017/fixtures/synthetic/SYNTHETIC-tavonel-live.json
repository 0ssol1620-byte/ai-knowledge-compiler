    {
      "name": "empty_output",
      "exchanges": [{"status": 200, "json": {"regions": []}}],
      "expected": {"status": "empty_output", "failure_class": "semantic", "attempts": 1, "markdown": ""}
    },
    {
      "name": "region_without_text",
      "exchanges": [{"status": 200, "json": {"regions": [{"pageNumber1": 1, "order": 0}]}}],
      "expected": {"status": "malformed_response", "attempts": 1, "markdown": ""}
