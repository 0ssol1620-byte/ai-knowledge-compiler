        {"regionId": "SYNTHETIC-r1", "pageNumber1": 1, "order": 0, "blockType": "paragraph", "text": "SYNTHETIC first paragraph."}
      ]}}],
      "expected": {
        "status": "ok", "attempts": 1, "page_count": null, "cost": "not_applicable",
        "markdown": "SYNTHETIC first paragraph.\n\nSYNTHETIC second paragraph.\n\nSYNTHETIC page two."
      }
    },
    {
      "name": "at_byte_limit_is_sent",
      "document": {"pad_to_bytes": 5242880},
