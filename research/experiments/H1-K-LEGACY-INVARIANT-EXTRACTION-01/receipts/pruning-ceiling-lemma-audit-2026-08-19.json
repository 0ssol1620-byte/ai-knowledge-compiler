  "identity_module_sha256": "sha256:0b27e1b505d4684eaaf07aea0d6ffc1df3f30e4b8b1d95c5025f83572a05fafc",
  "lemma_as_stated": "Pruning cannot turn AMBIGUOUS or NEW into MATCHED for a given row.",
  "lemma_is_sound_as_stated": true,
  "lemma_sufficient_for_exactness": false,
  "mechanism_correction": {
    "observed": "The flips are real and reproduce 8/8, but the scores are 0.60 and 0.4286 -- BELOW the 0.75 floor. The AMBIGUOUS comes from the missing-critical-signal branch (`source_continuity` absent), which is evaluated BEFORE the new-threshold check and returns AMBIGUOUS regardless of score.",
    "predicted": "AMBIGUOUS -> NEW would be demonstrated via the review band: a pruned candidate scoring in [0.75, 0.80] makes the row AMBIGUOUS when kept and NEW when withheld.",
    "review_band_gap_still_open": "The [0.75, 0.80] overlap argument is a SEPARATE analytic gap and was NOT exercised by these cases. It is reported as analysis, not as a measurement.",
    "why_the_finding_is_stronger_not_weaker": "The prediction required a narrow score window. The observed mechanism needs none: withholding ANY candidate that would have been the row's assigned partner can flip AMBIGUOUS -> NEW whenever a critical signal is absent, at any score within the pruning regime. The candidates used here have path_agreement 0.0 and scores <= 0.80, so they are exactly what the ceiling licenses pruning."
  },
