{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "karena.schema_induction.output.v1",
  "type": "object",
  "properties": {
    "entity_types": {
      "type": "array",
      "maxItems": 25,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 60
          },
          "definition": {
            "type": "string",
            "maxLength": 300
          },
          "examples": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "object",
              "properties": {
                "excerpt_id": {
                  "enum": [
                    "D1",
                    "D2",
                    "D3"
                  ]
                },
                "quote": {
                  "type": "string",
                  "maxLength": 300
                }
              },
              "required": [
                "excerpt_id",
                "quote"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "name",
          "definition",
          "examples"
        ],
        "additionalProperties": false
      }
    },
    "relation_types": {
      "type": "array",
      "maxItems": 15,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 60
          },
          "source_type": {
            "type": "string",
            "maxLength": 60
          },
          "target_type": {
            "type": "string",
            "maxLength": 60
          },
          "definition": {
            "type": "string",
            "maxLength": 300
          },
          "examples": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "object",
              "properties": {
                "excerpt_id": {
                  "enum": [
                    "D1",
                    "D2",
                    "D3"
                  ]
                },
                "quote": {
                  "type": "string",
                  "maxLength": 300
                }
              },
              "required": [
                "excerpt_id",
                "quote"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "name",
          "source_type",
          "target_type",
          "definition",
          "examples"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "entity_types",
    "relation_types"
  ],
  "additionalProperties": false
}
