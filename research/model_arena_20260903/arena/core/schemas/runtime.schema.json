{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tavonel:arena:runtime:v1",
  "title": "TAVONEL arena runtime specification",
  "description": "runtimes/<model_key>/runtime.json (ARENA_CONTRACT section 6). Everything is pinned: the base image by digest, the model by exact revision, and the largest weight file by sha256. 'schema' is optional here because runtime.json is a config file, not a campaign record. base_image must be digest-pinned (ARENA_CONTRACT 11.1 D5): a name:tag@sha256:<64 hex> form is allowed, a floating tag is not. gpu_count_min defaults to 1 when absent. ARENA_CONTRACT 11.5 D16 adds runtime_repository and runtime_revision - runtime.json owns them and the model registry is a derived copy - and 11.5 D34 adds prompt_kind. All three are nullable while the runtime lanes declare them, and a null is read as 'this runtime has not said', never as a default the worker may act on. min_cuda_version is the lowest CUDA version a host driver may report for this runtime's base image to start, as major.minor, derived from the image's own CUDA runtime and raised to any stricter vendor-documented floor; it becomes the RunPod create payload's allowedCudaVersions filter. It is nullable for the same reason: unset means 'not declared', and a runtime that starts a CUDA process without it is refused at the provisioning gate rather than placed on a host that cannot run it.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": { "enum": ["", "tavonel.arena.runtime.v1"] },
    "model_key": {
      "enum": [
        "paddleocr_vl_1_6", "mineru_pipeline", "mineru_vlm", "deepseek_ocr2",
        "ovisocr2", "unlimited_ocr", "infinity_parser2_pro",
        "infinity_parser2_flash", "monkeyocrv2_b",
        "olmocr2", "hpd_parsing", "glm_ocr", "opus5_subscription"
      ]
    },
    "display_name": { "type": "string", "minLength": 1 },
    "model_repo": { "type": "string", "minLength": 1 },
    "model_revision": { "type": "string", "minLength": 1 },
    "official_runtime": {
      "enum": ["vllm", "transformers", "paddle", "mineru_cli", "custom"]
    },
    "runtime_version": { "type": "string", "minLength": 1 },
    "runtime_repository": { "type": ["string", "null"], "minLength": 1 },
    "runtime_revision": { "type": ["string", "null"], "minLength": 1 },
    "base_image": { "type": "string", "pattern": "^[^\\s@]+@sha256:[0-9a-f]{64}$" },
    "gpu_min_vram_gb": { "type": "number", "minimum": 0 },
    "gpu_count_min": { "type": "integer", "minimum": 1, "default": 1 },
    "gpu_pool_priority": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "max_concurrency_per_worker": { "type": "integer", "minimum": 1 },
    "shard_size_hint": { "type": "integer", "minimum": 1 },
    "per_page_timeout_seconds": { "type": "integer", "minimum": 1 },
    "prompt_id": { "type": "string", "minLength": 1 },
    "prompt_kind": { "enum": ["text", "toolkit", "none", null] },
    "min_cuda_version": { "type": ["string", "null"], "pattern": "^\\d+\\.\\d+$" },
    "inference_config": { "type": "object" },
    "weights_strategy": { "enum": ["baked", "volume_cache", "boot_download"] },
    "runtime_mode_allowed": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["baked", "bootstrap", "subscription"] }
    },
    "official_source_urls": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "url": { "type": ["string", "null"] },
        "status": {
          "enum": [
            "verified", "approved", "unverified", "review_required",
            "blocked", "none_found", "not_reusable"
          ]
        },
        "name": { "type": ["string", "null"] },
        "spdx_base": { "type": ["string", "null"] },
        "additional_terms": { "type": ["boolean", "null"] },
        "text_sha256": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
        "source_url": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      },
      "required": ["id", "status"]
    },
    "notes": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repo": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "largest_file": { "type": "string", "minLength": 1 },
        "largest_file_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "required": ["largest_file", "largest_file_sha256", "repo", "revision"]
    }
  },
  "required": [
    "base_image", "display_name", "gpu_min_vram_gb", "gpu_pool_priority",
    "inference_config", "license", "max_concurrency_per_worker", "model_key",
    "model_repo", "model_revision", "notes", "official_runtime",
    "official_source_urls", "per_page_timeout_seconds", "prompt_id",
    "runtime_mode_allowed", "runtime_version", "shard_size_hint", "weights",
    "weights_strategy"
  ],
  "allOf": [
    {
      "if": {
        "properties": { "model_key": { "const": "mineru_vlm" } },
        "required": ["model_key"]
      },
      "then": { "properties": { "max_concurrency_per_worker": { "const": 1 } } }
    }
  ]
}
