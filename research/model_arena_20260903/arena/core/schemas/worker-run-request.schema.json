{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tavonel:arena:worker-run-request:v1",
  "title": "TAVONEL arena worker run request",
  "description": "POST /v1/run body (ARENA_CONTRACT section 4). image_b64 is the PNG page render; the worker verifies sha256(image bytes) == source_sha256 and answers CHECKSUM if it does not match.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": { "enum": ["", "tavonel.arena.worker-run-request.v1"] },
    "campaign_id": { "type": "string", "minLength": 1 },
    "inference_job_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sample_id": { "type": "string", "minLength": 1 },
    "case_key": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$" },
    "benchmark": { "enum": ["parsebench", "omnidoc", "olmocr"] },
    "source_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "image_b64": { "type": "string", "minLength": 1 },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "prompt_id": { "type": "string", "minLength": 1 },
    "prompt_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "inference_config_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "job_kind": { "enum": ["inference", "canary", "recovery"] },
    "metadata": { "type": "object" },
    "timeout_seconds": { "type": ["integer", "null"], "minimum": 1 }
  },
  "required": [
    "benchmark", "campaign_id", "case_key", "height", "image_b64",
    "inference_config_sha256", "inference_job_id", "job_kind", "prompt_id",
    "prompt_sha256", "sample_id", "source_sha256", "width"
  ]
}
