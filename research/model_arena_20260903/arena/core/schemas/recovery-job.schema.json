{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tavonel:arena:recovery-job:v1",
  "title": "TAVONEL arena recovery job",
  "description": "ARENA_CONTRACT section 3.6 / masterplan section 24. Recovery inference is planned before ground truth and its cost is kept separate from the base arena cost.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "tavonel.arena.recovery-job.v1" },
    "recovery_job_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "base_inference_job_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "case_key": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$" },
    "sample_id": { "type": "string", "minLength": 1 },
    "model_key": {
      "enum": [
        "paddleocr_vl_1_6", "mineru_pipeline", "mineru_vlm", "deepseek_ocr2",
        "ovisocr2", "unlimited_ocr", "infinity_parser2_pro",
        "infinity_parser2_flash", "monkeyocrv2_b",
        "olmocr2", "hpd_parsing", "glm_ocr", "opus5_subscription"
      ]
    },
    "recovery_type": {
      "enum": [
        "overlap_tiling", "crop", "region_extract", "higher_dpi",
        "alternative_prompt", "safer_config", "partial_page"
      ]
    },
    "recovery_config": { "type": "object" },
    "recovery_config_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "round": { "type": "integer", "minimum": 1 },
    "trigger_signals": { "type": "array", "items": { "type": "string" } },
    "planned_before_gt": { "const": true }
  },
  "required": [
    "base_inference_job_id", "case_key", "model_key", "planned_before_gt",
    "recovery_config", "recovery_config_sha256", "recovery_job_id",
    "recovery_type", "round", "sample_id", "schema", "trigger_signals"
  ]
}
