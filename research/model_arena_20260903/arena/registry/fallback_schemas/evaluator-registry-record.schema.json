{
  "$id": "tavonel.arena.evaluator-registry-record.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Fallback schema used only when arena/core/schemas/evaluator-registry-record.schema.json (lane A1) does not exist yet. It encodes ARENA_CONTRACT section 3.8.",
  "properties": {
    "benchmark": {
      "enum": ["parsebench", "omnidoc", "olmocr"]
    },
    "dataset_manifest_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "dataset_repository": { "minLength": 1, "type": "string" },
    "dataset_revision": { "pattern": "^[0-9a-f]{40}$", "type": "string" },
    "entrypoint": { "minLength": 1, "type": "string" },
    "frozen": { "type": "boolean" },
    "gt_paths": {
      "items": { "minLength": 1, "type": "string" },
      "minItems": 1,
      "type": "array"
    },
    "historical_lane_required": { "type": "boolean" },
    "historical_pin": { "pattern": "^[0-9a-f]{40}$", "type": "string" },
    "license": { "minLength": 1, "type": "string" },
    "main_pin": { "pattern": "^[0-9a-f]{40}$", "type": "string" },
    "main_pin_rationale": { "minLength": 40, "type": "string" },
    "repository": { "pattern": "^https://", "type": "string" },
    "schema": { "const": "tavonel.arena.evaluator-registry-record.v1" },
    "upstream_head_at_start": { "pattern": "^[0-9a-f]{40}$", "type": "string" }
  },
  "required": [
    "schema",
    "benchmark",
    "repository",
    "historical_pin",
    "upstream_head_at_start",
    "main_pin",
    "main_pin_rationale",
    "historical_lane_required",
    "entrypoint",
    "dataset_repository",
    "dataset_revision",
    "dataset_manifest_sha256",
    "gt_paths",
    "license",
    "frozen"
  ],
  "title": "TAVONEL arena evaluator registry record",
  "type": "object"
}
