{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-knowledge-compiler.example/benchmark/page-ground-truth-1.0.json",
  "title": "AKC Page Ground Truth",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_case_id",
    "document_id",
    "page_index",
    "language",
    "document_class",
    "high_risk",
    "text",
    "reading_order",
    "blocks",
    "generated_claims",
    "is_synthetic"
  ],
  "properties": {
    "benchmark_case_id": { "type": "string", "minLength": 1 },
    "document_id": { "type": "string", "pattern": "^urn:akmp:doc:" },
    "page_index": { "type": "integer", "minimum": 0 },
    "language": { "type": "string", "minLength": 2 },
    "document_class": { "type": "string", "minLength": 1 },
    "high_risk": { "type": "boolean" },
    "text": { "type": "string" },
    "reading_order": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "blocks": {
      "type": "array",
      "items": { "$ref": "#/$defs/block" }
    },
    "generated_claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim" }
    },
    "date_unit_annotations": { "$ref": "#/$defs/dateUnitAnnotations" },
    "heading_outline": {
      "type": "array",
      "items": { "$ref": "#/$defs/headingOutlineItem" }
    },
    "token_annotations": { "$ref": "#/$defs/tokenAnnotations" },
    "multi_page_table_merges": { "$ref": "#/$defs/edgePairs" },
    "knowledge_evaluation": { "$ref": "#/$defs/knowledgeEvaluation" },
    "rag_evaluation": { "$ref": "#/$defs/ragEvaluation" },
    "router_evaluation": { "$ref": "#/$defs/routerEvaluation" },
    "source": { "$ref": "#/$defs/source" },
    "is_synthetic": { "type": "boolean" }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "uniqueStringList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "tokenAnnotations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dates": { "$ref": "#/$defs/stringList" },
        "currencies": { "$ref": "#/$defs/stringList" },
        "percentages": { "$ref": "#/$defs/stringList" },
        "units": { "$ref": "#/$defs/stringList" },
        "serials": { "$ref": "#/$defs/stringList" },
        "models": { "$ref": "#/$defs/stringList" },
        "versions": { "$ref": "#/$defs/stringList" }
      },
      "minProperties": 1
    },
    "edgePairs": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          { "type": "string", "minLength": 1 },
          { "type": "string", "minLength": 1 }
        ],
        "minItems": 2,
        "maxItems": 2
      },
      "uniqueItems": true
    },
    "knowledgeNote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_block_ids"],
      "properties": {
        "note_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "source_block_ids": {
          "$ref": "#/$defs/uniqueStringList",
          "minItems": 1
        }
      }
    },
    "knowledgeRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target", "type"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 }
      }
    },
    "summaryClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_block_ids"],
      "properties": {
        "source_block_ids": { "$ref": "#/$defs/uniqueStringList" }
      }
    },
    "knowledgeEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "notes": {
          "type": "array",
          "items": { "$ref": "#/$defs/knowledgeNote" }
        },
        "relations": {
          "type": "array",
          "items": { "$ref": "#/$defs/knowledgeRelation" }
        },
        "conflicts": { "$ref": "#/$defs/uniqueStringList" },
        "summary_claims": {
          "type": "array",
          "items": { "$ref": "#/$defs/summaryClaim" }
        },
        "user_edit_pair": {
          "type": "object",
          "additionalProperties": false,
          "required": ["before", "after"],
          "properties": {
            "before": { "type": "string" },
            "after": { "type": "string" }
          }
        }
      },
      "minProperties": 1
    },
    "ragAnswerClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["citation_ids"],
      "properties": {
        "citation_ids": { "$ref": "#/$defs/uniqueStringList" }
      }
    },
    "ragQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query_id"],
      "properties": {
        "query_id": { "type": "string", "minLength": 1 },
        "relevant_ids": { "$ref": "#/$defs/uniqueStringList" },
        "retrieved_ids": { "$ref": "#/$defs/uniqueStringList" },
        "citation_ids": { "$ref": "#/$defs/uniqueStringList" },
        "answer_claims": {
          "type": "array",
          "items": { "$ref": "#/$defs/ragAnswerClaim" }
        },
        "stale_version_ids": { "$ref": "#/$defs/uniqueStringList" },
        "rejected_version_ids": { "$ref": "#/$defs/uniqueStringList" },
        "unanswerable": { "type": "boolean" },
        "refused": { "type": "boolean" },
        "required_evidence_groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/uniqueStringList",
            "minItems": 1
          }
        }
      }
    },
    "ragEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queries"],
      "properties": {
        "queries": {
          "type": "array",
          "items": { "$ref": "#/$defs/ragQuery" }
        }
      }
    },
    "routerPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_class",
        "first_pass_failed",
        "escalated",
        "fallback"
      ],
      "properties": {
        "document_class": { "type": "string", "minLength": 1 },
        "first_pass_failed": { "type": "boolean" },
        "escalated": { "type": "boolean" },
        "fallback": { "type": "boolean" },
        "quality_after_escalation": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "variable_cost": { "type": "number", "minimum": 0 },
        "latency_ms": { "type": "number", "minimum": 0 },
        "best_route_quality": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "chosen_route_quality": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "routerEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pages"],
      "properties": {
        "pages": {
          "type": "array",
          "items": { "$ref": "#/$defs/routerPage" }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "filename", "content_type", "sha256"],
      "properties": {
        "path": {
          "description": "POSIX-style path relative to the separately approved corpus root.",
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "filename": { "type": "string", "minLength": 1, "maxLength": 240 },
        "content_type": { "type": "string", "minLength": 3, "maxLength": 200 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "bbox1000": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": 0, "maximum": 1000 },
        { "type": "integer", "minimum": 0, "maximum": 1000 },
        { "type": "integer", "minimum": 0, "maximum": 1000 },
        { "type": "integer", "minimum": 0, "maximum": 1000 }
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "dateUnitAnnotations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dates": {
          "description": "Canonical date strings in reading order; case and punctuation are significant.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "units": {
          "description": "Unit labels or symbols in reading order, without their numeric amounts.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "anyOf": [{ "required": ["dates"] }, { "required": ["units"] }]
    },
    "headingOutlineItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "text"],
      "properties": {
        "level": { "type": "integer", "minimum": 1, "maximum": 6 },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "tableCell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_index0",
        "column_index0",
        "row_span",
        "column_span",
        "text"
      ],
      "properties": {
        "row_index0": { "type": "integer", "minimum": 0 },
        "column_index0": { "type": "integer", "minimum": 0 },
        "row_span": { "type": "integer", "minimum": 1 },
        "column_span": { "type": "integer", "minimum": 1 },
        "text": { "type": "string" }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_count", "column_count", "header_row_count", "cells"],
      "properties": {
        "row_count": { "type": "integer", "minimum": 1 },
        "column_count": { "type": "integer", "minimum": 1 },
        "header_row_count": { "type": "integer", "minimum": 0 },
        "cells": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/tableCell" }
        }
      },
      "description": "Evaluator-ready grid. Cells must be in bounds and spans must not overlap."
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_index", "bbox1000"],
      "properties": {
        "page_index": { "type": "integer", "minimum": 0 },
        "bbox1000": { "$ref": "#/$defs/bbox1000" }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_id", "type", "text", "origin", "source_refs"],
      "properties": {
        "block_id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "text": { "type": "string" },
        "heading_level": { "type": "integer", "minimum": 1, "maximum": 6 },
        "formula_latex": { "type": "string", "minLength": 1 },
        "caption_for_block_id": { "type": "string", "minLength": 1 },
        "table": { "$ref": "#/$defs/table" },
        "origin": {
          "enum": [
            "native_extracted",
            "ocr_extracted",
            "rule_reconstructed",
            "ai_reconstructed",
            "ai_summarized",
            "ai_inferred",
            "user_edited"
          ]
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceRef" }
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "source_block_ids", "origin"],
      "properties": {
        "text": { "type": "string" },
        "source_block_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "origin": { "enum": ["ai_summarized", "ai_inferred", "user_edited"] }
      }
    }
  }
}
