{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-knowledge-compiler.example/benchmark/score-record-2.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_id",
    "evaluator_version",
    "corpus_version",
    "benchmark_case_id",
    "provider",
    "model_revision",
    "claim_class",
    "is_synthetic",
    "metrics",
    "hard_failures",
    "reproducibility"
  ],
  "properties": {
    "benchmark_id": { "type": "string" },
    "evaluator_version": { "const": "22.4-22.8-v1.0.0" },
    "corpus_version": { "type": "string" },
    "benchmark_case_id": { "type": "string" },
    "provider": { "type": "string" },
    "model_revision": { "type": "string" },
    "claim_class": {
      "enum": [
        "contract_test",
        "official_claim",
        "independent_result",
        "internal_result",
        "estimate",
        "hypothesis"
      ]
    },
    "is_synthetic": { "type": "boolean" },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_validity",
        "cer",
        "wer",
        "normalized_edit_similarity",
        "reading_order_pair_accuracy",
        "table_teds",
        "table_cell_exactness",
        "formula_edit_score",
        "heading_tree_score",
        "numeric_exact_match",
        "date_unit_exact_match",
        "provenance_coverage",
        "unsupported_claim_rate",
        "repetition_rate",
        "latency_ms",
        "p50_latency_ms",
        "p95_latency_ms",
        "cold_start_ms",
        "gpu_seconds",
        "peak_vram_mb",
        "estimated_cost_usd",
        "normalized_speed",
        "hangul_syllable_corruption_rate",
        "hangul_jamo_corruption_rate",
        "punctuation_accuracy",
        "whitespace_normalized_exact_match",
        "date_exact_match",
        "currency_percent_unit_match",
        "identifier_exact_match",
        "block_detection_precision_iou50",
        "block_detection_recall_iou50",
        "block_type_macro_f1_iou50",
        "reading_order_kendall_tau",
        "reading_order_spearman_rho",
        "header_footer_precision_iou50",
        "header_footer_recall_iou50",
        "caption_association_accuracy",
        "heading_text_f1",
        "heading_level_accuracy",
        "heading_hierarchy_edit_distance",
        "table_row_count_accuracy",
        "table_column_count_accuracy",
        "table_cell_edit_score",
        "table_span_accuracy",
        "multi_page_table_merge_accuracy",
        "formula_exact_match",
        "formula_symbol_edit_distance",
        "equation_block_precision_iou50",
        "equation_block_recall_iou50",
        "source_page_accuracy",
        "source_bbox_iou",
        "note_split_precision",
        "note_split_recall",
        "title_quality_human_score",
        "duplicate_note_rate",
        "unsupported_summary_claim_rate",
        "relation_precision",
        "evidence_completeness",
        "conflict_detection_recall",
        "user_edit_distance",
        "review_time_ms",
        "rag_recall_at_5",
        "rag_recall_at_10",
        "rag_mrr",
        "rag_ndcg_at_10",
        "rag_citation_precision",
        "rag_citation_recall",
        "rag_answer_groundedness",
        "rag_stale_version_rejection",
        "rag_unanswerable_refusal_accuracy",
        "rag_multihop_evidence_completeness",
        "router_first_pass_acceptance_rate",
        "router_escalation_recall",
        "router_false_escalation_rate",
        "router_fallback_rate",
        "router_quality_after_escalation",
        "router_cost_per_page_by_class",
        "router_latency_ms_per_page_by_class",
        "router_route_regret"
      ],
      "properties": {
        "schema_validity": {
          "description": "One only after parser-output schema validation succeeds.",
          "const": 1.0
        },
        "cer": {
          "description": "Unicode-NFC character error rate; may exceed 1 when insertions exceed reference length.",
          "type": ["number", "null"],
          "minimum": 0
        },
        "wer": {
          "description": "Unicode token word error rate; may exceed 1 when insertions exceed reference length.",
          "type": ["number", "null"],
          "minimum": 0
        },
        "normalized_edit_similarity": {
          "description": "Character edit similarity after line-ending and Unicode-NFC normalization.",
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "reading_order_pair_accuracy": {
          "description": "Fraction of reference block pairs retaining their relative order.",
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "table_teds": {
          "description": "AKC deterministic ordered tree-token table-structure similarity. TEDS-style only; not the official TEDS implementation and excludes cell text.",
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "table_cell_exactness": {
          "description": "Exact row/column/span/text cell matches divided by the larger cell count, averaged by table order; extra and missing tables score zero.",
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "formula_edit_score": {
          "description": "Reading-order average of normalized LaTeX character-edit similarity; wrappers, whitespace, left/right sizing, and common Unicode operators are normalized.",
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "heading_tree_score": {
          "description": "Weighted outline edit similarity over heading levels and contract-normalized labels.",
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "numeric_exact_match": {
          "description": "Binary ordered numeric-token equality, null when neither side contains a numeric token.",
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "date_unit_exact_match": {
          "description": "Binary ordered equality of explicit date and unit annotations; independent of numeric token matching.",
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "provenance_coverage": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "unsupported_claim_rate": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "repetition_rate": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "latency_ms": { "type": ["number", "null"], "minimum": 0 },
        "p50_latency_ms": { "type": ["number", "null"], "minimum": 0 },
        "p95_latency_ms": { "type": ["number", "null"], "minimum": 0 },
        "cold_start_ms": { "type": ["number", "null"], "minimum": 0 },
        "gpu_seconds": { "type": ["number", "null"], "minimum": 0 },
        "peak_vram_mb": { "type": ["number", "null"], "minimum": 0 },
        "estimated_cost_usd": { "type": ["number", "null"], "minimum": 0 },
        "normalized_speed": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "hangul_syllable_corruption_rate": {
          "$ref": "#/$defs/nonnegativeMetric"
        },
        "hangul_jamo_corruption_rate": { "$ref": "#/$defs/nonnegativeMetric" },
        "punctuation_accuracy": { "$ref": "#/$defs/unitMetric" },
        "whitespace_normalized_exact_match": { "$ref": "#/$defs/unitMetric" },
        "date_exact_match": { "$ref": "#/$defs/unitMetric" },
        "currency_percent_unit_match": { "$ref": "#/$defs/unitMetric" },
        "identifier_exact_match": { "$ref": "#/$defs/unitMetric" },
        "block_detection_precision_iou50": { "$ref": "#/$defs/unitMetric" },
        "block_detection_recall_iou50": { "$ref": "#/$defs/unitMetric" },
        "block_type_macro_f1_iou50": { "$ref": "#/$defs/unitMetric" },
        "reading_order_kendall_tau": { "$ref": "#/$defs/correlationMetric" },
        "reading_order_spearman_rho": { "$ref": "#/$defs/correlationMetric" },
        "header_footer_precision_iou50": { "$ref": "#/$defs/unitMetric" },
        "header_footer_recall_iou50": { "$ref": "#/$defs/unitMetric" },
        "caption_association_accuracy": { "$ref": "#/$defs/unitMetric" },
        "heading_text_f1": { "$ref": "#/$defs/unitMetric" },
        "heading_level_accuracy": { "$ref": "#/$defs/unitMetric" },
        "heading_hierarchy_edit_distance": {
          "$ref": "#/$defs/nonnegativeMetric"
        },
        "table_row_count_accuracy": { "$ref": "#/$defs/unitMetric" },
        "table_column_count_accuracy": { "$ref": "#/$defs/unitMetric" },
        "table_cell_edit_score": { "$ref": "#/$defs/unitMetric" },
        "table_span_accuracy": { "$ref": "#/$defs/unitMetric" },
        "multi_page_table_merge_accuracy": { "$ref": "#/$defs/unitMetric" },
        "formula_exact_match": { "$ref": "#/$defs/unitMetric" },
        "formula_symbol_edit_distance": { "$ref": "#/$defs/nonnegativeMetric" },
        "equation_block_precision_iou50": { "$ref": "#/$defs/unitMetric" },
        "equation_block_recall_iou50": { "$ref": "#/$defs/unitMetric" },
        "source_page_accuracy": { "$ref": "#/$defs/unitMetric" },
        "source_bbox_iou": { "$ref": "#/$defs/unitMetric" },
        "note_split_precision": { "$ref": "#/$defs/unitMetric" },
        "note_split_recall": { "$ref": "#/$defs/unitMetric" },
        "title_quality_human_score": {
          "description": "Null unless backed by at least two reviewers, a rubric version, and an immutable evidence hash.",
          "$ref": "#/$defs/unitMetric"
        },
        "duplicate_note_rate": { "$ref": "#/$defs/unitMetric" },
        "unsupported_summary_claim_rate": { "$ref": "#/$defs/unitMetric" },
        "relation_precision": { "$ref": "#/$defs/unitMetric" },
        "evidence_completeness": { "$ref": "#/$defs/unitMetric" },
        "conflict_detection_recall": { "$ref": "#/$defs/unitMetric" },
        "user_edit_distance": { "$ref": "#/$defs/nonnegativeMetric" },
        "review_time_ms": {
          "description": "Measured duration only; unavailable when no trusted timing is supplied.",
          "$ref": "#/$defs/nonnegativeMetric"
        },
        "rag_recall_at_5": { "$ref": "#/$defs/unitMetric" },
        "rag_recall_at_10": { "$ref": "#/$defs/unitMetric" },
        "rag_mrr": { "$ref": "#/$defs/unitMetric" },
        "rag_ndcg_at_10": { "$ref": "#/$defs/unitMetric" },
        "rag_citation_precision": { "$ref": "#/$defs/unitMetric" },
        "rag_citation_recall": { "$ref": "#/$defs/unitMetric" },
        "rag_answer_groundedness": { "$ref": "#/$defs/unitMetric" },
        "rag_stale_version_rejection": { "$ref": "#/$defs/unitMetric" },
        "rag_unanswerable_refusal_accuracy": { "$ref": "#/$defs/unitMetric" },
        "rag_multihop_evidence_completeness": { "$ref": "#/$defs/unitMetric" },
        "router_first_pass_acceptance_rate": { "$ref": "#/$defs/unitMetric" },
        "router_escalation_recall": { "$ref": "#/$defs/unitMetric" },
        "router_false_escalation_rate": { "$ref": "#/$defs/unitMetric" },
        "router_fallback_rate": { "$ref": "#/$defs/unitMetric" },
        "router_quality_after_escalation": { "$ref": "#/$defs/unitMetric" },
        "router_cost_per_page_by_class": { "$ref": "#/$defs/classMetricMap" },
        "router_latency_ms_per_page_by_class": {
          "$ref": "#/$defs/classMetricMap"
        },
        "router_route_regret": { "$ref": "#/$defs/nonnegativeMetric" }
      }
    },
    "utility": { "type": ["number", "null"] },
    "hard_failures": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "reproducibility": {
      "type": "object",
      "required": [
        "started_at",
        "finished_at",
        "input_sha256",
        "prompt_schema_version"
      ],
      "properties": {
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" },
        "input_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "prompt_schema_version": { "type": "string" },
        "source_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "raw_result_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  },
  "$defs": {
    "unitMetric": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "nonnegativeMetric": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "correlationMetric": {
      "type": ["number", "null"],
      "minimum": -1,
      "maximum": 1
    },
    "classMetricMap": {
      "type": ["object", "null"],
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    }
  }
}
