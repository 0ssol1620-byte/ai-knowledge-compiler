{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structara.example/schemas/public-execution-preflight.schema.json",
  "title": "Structara Public Benchmark Execution Preflight Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_kind",
    "suite_id",
    "benchmark_id",
    "status",
    "blockers",
    "required_repetitions_per_candidate",
    "required_subjects",
    "registry_sha256",
    "evaluator",
    "dataset",
    "input_receipts",
    "official_runs_completed",
    "production_evidence",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "receipt_kind": {"const": "public_benchmark_execution_preflight"},
    "suite_id": {"type": "string", "minLength": 1},
    "benchmark_id": {"enum": ["omnidocbench", "parsebench", "olmocr-bench"]},
    "status": {"enum": ["ready", "blocked"]},
    "blockers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "required_repetitions_per_candidate": {"const": 3},
    "required_subjects": {"const": ["candidate", "incumbent"]},
    "registry_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "evaluator": {"type": "object"},
    "dataset": {"type": "object"},
    "input_receipts": {"type": "object"},
    "official_runs_completed": {"const": 0},
    "production_evidence": {"const": false},
    "limitations": {
      "type": "array",
      "contains": {"const": "no_official_evaluator_executed"}
    }
  }
}
