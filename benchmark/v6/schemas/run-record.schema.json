{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structara.example/schemas/v6/run-record.schema.json",
  "title": "Structara v6 immutable benchmark run record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "cohort_id",
    "candidate_id",
    "benchmark_id",
    "repeat_index",
    "environment_sha256",
    "prediction_root",
    "log_root",
    "prediction_archive_sha256",
    "official_output_sha256",
    "critical_output_sha256",
    "failure_bundle_sha256",
    "started_at",
    "finished_at",
    "gpu_seconds",
    "actual_cost_usd",
    "critical_failure_count",
    "gt_leakage_count",
    "status",
    "production_actual"
  ],
  "properties": {
    "run_id": { "type": "string", "minLength": 8 },
    "cohort_id": { "type": "string", "minLength": 8 },
    "candidate_id": { "type": "string", "minLength": 1 },
    "benchmark_id": { "type": "string", "minLength": 1 },
    "repeat_index": { "type": "integer", "minimum": 1, "maximum": 3 },
    "environment_sha256": { "$ref": "#/$defs/sha256" },
    "prediction_root": { "type": "string", "minLength": 1 },
    "log_root": { "type": "string", "minLength": 1 },
    "prediction_archive_sha256": { "$ref": "#/$defs/sha256" },
    "official_output_sha256": { "$ref": "#/$defs/sha256" },
    "critical_output_sha256": { "$ref": "#/$defs/sha256" },
    "failure_bundle_sha256": { "$ref": "#/$defs/sha256" },
    "started_at": { "$ref": "#/$defs/timestamp" },
    "finished_at": { "$ref": "#/$defs/timestamp" },
    "gpu_seconds": { "type": "number", "minimum": 0 },
    "actual_cost_usd": { "type": "number", "minimum": 0 },
    "critical_failure_count": { "type": "integer", "minimum": 0 },
    "gt_leakage_count": { "const": 0 },
    "status": { "enum": ["passed", "failed", "invalidated", "blocked"] },
    "production_actual": { "type": "boolean" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "Z$" }
  }
}
