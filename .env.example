# Runtime
AKC_ENV=development
AKC_LOG_LEVEL=INFO
# Required in production; pin this to the exact 40-character release commit.
AKC_DEPLOYMENT_REVISION=
NEXT_PUBLIC_AKC_API_URL=http://localhost:8000
NEXT_PUBLIC_AKC_DEMO_MODE=false
# Optional product-owned Spline scene exported for React/Next.js. When blank,
# the landing hero uses the same reduced-motion-safe native evidence scene.
NEXT_PUBLIC_AKC_SPLINE_SCENE_URL=
AKC_WEB_ORIGINS=http://localhost:3000
AKC_DATA_DIR=.akc-data

# Authentication (replace in every non-local environment)
AKC_JWT_SECRET=replace-with-at-least-32-random-characters
AKC_JWT_ISSUER=ai-knowledge-compiler
AKC_ACCESS_TOKEN_MINUTES=30
AKC_REFRESH_TOKEN_DAYS=14
AKC_SESSION_COOKIE_NAME=akc_session
AKC_COOKIE_SECURE=false
AKC_COOKIE_SAMESITE=lax

# Optional verified OIDC authorization-code provider. Discovery, token, and
# JWKS endpoints are HTTPS allowlisted; PKCE/state/nonce are mandatory. Keep
# disabled until every production secret and provider redirect is configured.
AKC_OIDC_ENABLED=false
AKC_OIDC_ISSUER_URL=
AKC_OIDC_CLIENT_ID=
AKC_OIDC_CLIENT_SECRET=
AKC_OIDC_REDIRECT_URI=
AKC_OIDC_SCOPES=openid email profile
AKC_OIDC_ALLOWED_ALGORITHMS=RS256,ES256
AKC_OIDC_ALLOWED_ENDPOINT_HOSTS=
AKC_OIDC_HTTP_TIMEOUT_SECONDS=10
AKC_OIDC_CACHE_TTL_SECONDS=300
AKC_OIDC_TRANSACTION_TTL_SECONDS=300
AKC_OIDC_TRANSACTION_ENCRYPTION_KEY=
AKC_OIDC_STATE_HMAC_SECRET=

# Team/Enterprise MFA. Production requires a dedicated Fernet key and a
# distinct 32-byte-or-longer HMAC secret; recovery codes are never stored raw.
AKC_MFA_ENCRYPTION_KEY=
AKC_MFA_RECOVERY_HMAC_SECRET=
AKC_MFA_CHALLENGE_TTL_SECONDS=300
AKC_MFA_REQUIRED_PLANS=team,enterprise

# Verified-email activation and privacy-safe abuse controls. Blank HMAC and
# Fernet values derive isolated local-only keys; production requires distinct
# explicit secrets, Redis over TLS, Turnstile, and Resend.
AKC_ABUSE_IDENTITY_HMAC_SECRET=
AKC_TRUSTED_PROXY_CIDRS=
AKC_RATE_LIMIT_MEMORY_MAX_BUCKETS=10000
AKC_REGISTER_CLIENT_LIMIT=5
AKC_REGISTER_ACCOUNT_LIMIT=3
AKC_REGISTER_WINDOW_SECONDS=3600
AKC_REGISTER_CAPTCHA_AFTER=3
AKC_LOGIN_CLIENT_LIMIT=20
AKC_LOGIN_ACCOUNT_LIMIT=10
AKC_LOGIN_WINDOW_SECONDS=900
AKC_LOGIN_CAPTCHA_AFTER=5
AKC_VERIFY_CLIENT_LIMIT=20
AKC_VERIFY_WINDOW_SECONDS=900
AKC_RESEND_CLIENT_LIMIT=5
AKC_RESEND_ACCOUNT_LIMIT=3
AKC_RESEND_WINDOW_SECONDS=3600
AKC_RESEND_CAPTCHA_AFTER=2
AKC_OPERATION_ACCOUNT_LIMIT=30
AKC_OPERATION_TENANT_LIMIT=100
AKC_OPERATION_WINDOW_SECONDS=60
AKC_CAPTCHA_PROVIDER=disabled
AKC_CAPTCHA_SECRET_KEY=
AKC_CAPTCHA_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
AKC_CAPTCHA_TIMEOUT_SECONDS=5
AKC_EMAIL_VERIFICATION_ENABLED=true
AKC_EMAIL_VERIFICATION_PROVIDER=capture
AKC_VERIFICATION_HMAC_SECRET=
AKC_VERIFICATION_DELIVERY_ENCRYPTION_KEY=
AKC_IDEMPOTENCY_RESPONSE_ENCRYPTION_KEY=
AKC_IDEMPOTENCY_RETENTION_DAYS=30
AKC_VERIFICATION_TOKEN_TTL_SECONDS=1800
AKC_TEAM_INVITATION_TTL_SECONDS=604800
AKC_VERIFICATION_DELIVERY_MAX_ATTEMPTS=5
AKC_VERIFICATION_DELIVERY_RETRY_SECONDS=60
AKC_VERIFICATION_PUBLIC_BASE_URL=http://localhost:3000
AKC_RESEND_API_KEY=
AKC_RESEND_SENDER=
AKC_RESEND_TIMEOUT_SECONDS=10
AKC_TEST_SUPPORT_KEY=
AKC_FREE_DAILY_FILE_CAP=5
AKC_FREE_DAILY_PAGE_CAP=50
AKC_FREE_DAILY_GPU_COST_USD_CAP=1.000000
AKC_FREE_GPU_COST_PER_VISUAL_PAGE_USD=0.020000
AKC_PAYMENTS_ENABLED=false
AKC_PAYMENT_PROVIDER=disabled
AKC_PAYMENT_MERCHANT_ID=
AKC_PAYMENT_WEBHOOK_SECRET=
AKC_PAYMENT_SUPPORTED_CURRENCIES=KRW,USD
AKC_PAYMENT_CHECKOUT_TTL_SECONDS=1800
AKC_PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
AKC_PAYMENT_WEBHOOK_MAX_BYTES=65536
AKC_PAYMENT_EVENT_MAX_ATTEMPTS=8
AKC_PAYMENT_EVENT_RETRY_SECONDS=60
AKC_PAYMENT_RECONCILIATION_INTERVAL_SECONDS=3600
AKC_PAYMENT_RECONCILIATION_BATCH_SIZE=100

# Database
AKC_DATABASE_URL=postgresql+asyncpg://akc:akc@localhost:5432/akc

# Object storage. Local filesystem is the safe development default.
AKC_OBJECT_STORE_DRIVER=local
AKC_S3_USE_AMBIENT_CREDENTIALS=true
AKC_S3_ENDPOINT_URL=http://localhost:9000
AKC_S3_REGION=ap-northeast-2
AKC_S3_ACCESS_KEY_ID=
AKC_S3_SECRET_ACCESS_KEY=
AKC_S3_SOURCE_ACCESS_KEY_ID=
AKC_S3_SOURCE_SECRET_ACCESS_KEY=
AKC_S3_WORKING_ACCESS_KEY_ID=
AKC_S3_WORKING_SECRET_ACCESS_KEY=
AKC_S3_DERIVED_ACCESS_KEY_ID=
AKC_S3_DERIVED_SECRET_ACCESS_KEY=
AKC_S3_AUDIT_ACCESS_KEY_ID=
AKC_S3_AUDIT_SECRET_ACCESS_KEY=
AKC_S3_DELETION_MODE=versioned
AKC_S3_BUCKET_QUARANTINE=akc-intake-quarantine
AKC_S3_BUCKET_SOURCE=akc-source-private
AKC_S3_BUCKET_WORKING=akc-working-private
AKC_S3_BUCKET_DERIVED=akc-derived-private
AKC_S3_BUCKET_EXPORTS=akc-exports-private
AKC_S3_BUCKET_AUDIT=akc-audit-evidence
AKC_PRESIGNED_UPLOAD_TTL_SECONDS=600
AKC_PRESIGNED_DOWNLOAD_TTL_SECONDS=300
AKC_MULTIPART_SESSION_TTL_SECONDS=86400
AKC_MULTIPART_UPLOAD_THRESHOLD_BYTES=52428800
AKC_MULTIPART_PART_SIZE_BYTES=8388608
AKC_MULTIPART_MAX_PARTS=10000
AKC_MULTIPART_PRESIGN_BATCH_SIZE=20
AKC_MULTIPART_CLIENT_CONCURRENCY=4
AKC_MULTIPART_CLIENT_MAX_RETRIES=3
AKC_MULTIPART_UPLOAD_THRESHOLD_BYTES=52428800
AKC_MULTIPART_PART_SIZE_BYTES=8388608
AKC_MULTIPART_MAX_PARTS=10000
AKC_MULTIPART_PRESIGN_BATCH_SIZE=20
AKC_MULTIPART_CLIENT_CONCURRENCY=4
AKC_MULTIPART_CLIENT_MAX_RETRIES=3

# Providers: all external transfer remains disabled until tenant opt-in.
AKC_PARSER_PROVIDER=mock
AKC_KNOWLEDGE_PROVIDER=deterministic
AKC_QWEN_ENDPOINT_ID=
AKC_QWEN_PROVIDER_KEY=qwen3_5_4b
AKC_QWEN_MODEL_REVISION=
AKC_QWEN_RUNTIME_IMAGE_DIGEST=
AKC_QWEN_ADAPTER_VERSION=
AKC_QWEN_PROMPT_REVISION=
AKC_QWEN_KNOWLEDGE_SCHEMA_SHA256=
AKC_QWEN_MAX_ATTEMPTS=3
# Collection source labels and paths must never be written as plaintext.
# Production may enable this only with a KMS/Secret-backed versioned keyring.
AKC_COLLECTION_METADATA_ENCRYPTION_ENABLED=false
AKC_COLLECTION_METADATA_ACTIVE_KEY_ID=
AKC_COLLECTION_METADATA_KEYRING=
AKC_COLLECTION_METADATA_BLIND_INDEX_KEY_ID=
AKC_COLLECTION_METADATA_BLIND_INDEX_KEY=
# Production semantic retrieval stays disabled until PostgreSQL migrations,
# a pinned embedding release, narrow provider egress, and external Secrets exist.
AKC_COLLECTION_SEMANTIC_RETRIEVAL_ENABLED=false
AKC_COLLECTION_SEMANTIC_RETRIEVAL_ROW_HMAC_SECRET=
AKC_COLLECTION_SEMANTIC_RETRIEVAL_EMBEDDING_ENDPOINT_URL=
AKC_COLLECTION_SEMANTIC_RETRIEVAL_EMBEDDING_API_KEY=
AKC_COLLECTION_SEMANTIC_RETRIEVAL_EMBEDDING_PROVIDER_ID=
AKC_COLLECTION_SEMANTIC_RETRIEVAL_EMBEDDING_MODEL_ID=
AKC_COLLECTION_SEMANTIC_RETRIEVAL_EMBEDDING_MODEL_REVISION=
AKC_COLLECTION_SEMANTIC_RETRIEVAL_EMBEDDING_TIMEOUT_SECONDS=20
AKC_COLLECTION_SEMANTIC_RETRIEVAL_EMBEDDING_CONCURRENCY=4
AKC_COLLECTION_FINALIZER_HMAC_SECRET=
AKC_COLLECTION_FINALIZER_ENABLED=false
AKC_COLLECTION_FINALIZER_API_URL=http://akc-api:8000/v1/internal/collections/finalize
AKC_COLLECTION_FINALIZER_TIMEOUT_SECONDS=300
AKC_EXTERNAL_OCR_ENABLED=false

# Security / retention
AKC_MAX_UPLOAD_BYTES=1073741824
AKC_MAX_PAGES=500
AKC_MAX_ARCHIVE_FILES=2000
AKC_MAX_ARCHIVE_UNCOMPRESSED_BYTES=262144000
AKC_MAX_ARCHIVE_RATIO=100
AKC_PRIVATE_MODE=true
AKC_DEFAULT_RETENTION_DAYS=7
AKC_EVENT_RETENTION_DAYS=7
AKC_TRAINING_OPT_IN_DEFAULT=false
AKC_LOCAL_BACKGROUND_TASKS=true
AKC_LOCAL_ANALYSIS_WORKER_ENABLED=false
AKC_ANALYSIS_MAX_SOURCE_BYTES=268435456
AKC_ANALYSIS_MAX_ATTEMPTS=3
AKC_ANALYSIS_LEASE_SECONDS=330
AKC_ANALYSIS_ATTEMPT_TIMEOUT_SECONDS=300
AKC_ANALYSIS_BACKOFF_BASE_SECONDS=2
AKC_ANALYSIS_BACKOFF_MAX_SECONDS=120
AKC_ALLOW_PUBLIC_REGISTRATION=true
AKC_URL_INGESTION_ENABLED=false
AKC_URL_ENCRYPTION_KEY=
AKC_URL_QUERY_HMAC_SECRET=
AKC_URL_FETCH_MAX_ATTEMPTS=5
AKC_URL_FETCH_MAX_BYTES=52428800
AKC_URL_FETCH_CONNECT_TIMEOUT_SECONDS=5
AKC_URL_FETCH_READ_TIMEOUT_SECONDS=20
AKC_URL_FETCH_TOTAL_TIMEOUT_SECONDS=30
AKC_URL_FETCH_MAX_REDIRECTS=5
AKC_URL_FETCH_POLL_INTERVAL_SECONDS=0.5
AKC_URL_FETCH_LEASE_SECONDS=90
AKC_URL_FETCH_BACKOFF_BASE_SECONDS=2
AKC_URL_FETCH_BACKOFF_MAX_SECONDS=300
AKC_URL_FETCH_BACKOFF_JITTER_RATIO=0.2
AKC_PDF_PASSWORD_ENCRYPTION_KEY=
AKC_PDF_PASSWORD_HMAC_SECRET=
AKC_PDF_PASSWORD_TTL_SECONDS=300
AKC_PDF_PASSWORD_MAX_ATTEMPTS=3
AKC_CLAMAV_ENABLED=false
AKC_CLAMAV_HOST=localhost
AKC_CLAMAV_PORT=3310
AKC_CLAMAV_TIMEOUT_SECONDS=20
AKC_CDR_ENABLED=false
AKC_CDR_PROVIDER=unavailable
AKC_CDR_ENDPOINT_URL=
AKC_CDR_API_KEY=
AKC_CDR_TIMEOUT_SECONDS=60
AKC_CDR_MAX_OUTPUT_BYTES=536870912
AKC_CDR_SUPPORTED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
AKC_ALLOW_DEVELOPMENT_ANTIVIRUS_BYPASS=true

# Durable scheduler and signed webhooks. Production requires a Fernet key and
