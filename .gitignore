.DS_Store
Thumbs.db
desktop.ini

# Infrastructure state
.terraform/
*.tfstate
*.tfstate.*
crash.log

.vercel

# Operator scratch from live campaign runs. These hold provider Pod ids and the
# addresses assigned to them for a few hours; they are working notes, not
# receipts, and the receipts under benchmark/datasets/private are the record.
.local/
.local-demo/
.retry_pods.json
.live_retry_workers.json
# Font build scratch environment (tools/fonts/build_fonts.py)
.venv-fonts/

# Agent skill installs. `.agents/skills/` and skills-lock.json are committed —
# the reference material is useful to later waves and the lockfile pins what
# was reviewed. `.claude/skills/` is not: the installer writes absolute
# symlinks into it, so the entries are valid only on the machine that ran it.
.claude/skills/

# Vercel CLI state: project link and the OIDC token it writes locally.
# The CLI also appends its own `.env*` rule here on link; it is dropped
# because it lands after the `!.env.example` exception above and silently
# re-ignores the one env file that is meant to be committed. Lines 2-4
# already cover real env files.

# pnpm install transcript, written when the registry is slow enough to need one
.pnpm-install.log

# eslint/vitest JSON reports written during gate runs
.eslint.json
.vitest.json

# Hybrid Runtime - machine-local and secret material
.claude/settings.local.json
.hybrid-agent/
**/auth.json

# Release-only virtualenv for rendering the hand-over package (reportlab,
# pypdf). Deliberately separate from .venv so the tested environment, and the
# repository_green receipt taken under it, are untouched by build tooling.
.venv-release/

# ---------------------------------------------------------------------------
# 2026-09-03 dirty-tree closure (research/source-faithful-kc-v1)
#
# Everything below is either machine-local agent state or an acquired corpus
# whose bytes are already bound by digest in a committed receipt. Nothing here
# is a receipt, a protocol, a spent cohort record or a failed-experiment
# artifact -- those are committed, per the evidence rule in CLAUDE.md.
# ---------------------------------------------------------------------------

# Codex CLI machine-local config and its scratch copy of the trademark package.
# The authoritative filing package lives outside the repository.
.codex/

# Hybrid Runtime installer backups of AGENTS.md / CLAUDE.md, and the template it
# ships. The live files are committed; these are the installer's undo copies.
*.bak-2026*
*.hybrid-template
.hybrid-agent-backup-*/

# Lighthouse CI run output. Regenerated by `pnpm lighthouse`; the reports carry
# the loopback address of the machine that produced them.
apps/web/.lighthouseci/

# Scratch output directory written by tooling runs.
/output/

# Zero-byte file created by a stray shell redirect on 2026-08-17.
/3

# Acquired benchmark corpora. The bytes are third-party and re-acquirable; each
# case is bound by input_sha256 / source_sha256 / dataset_revision in the
# committed manifest beside it, so a clone can verify every published number
# without the repository carrying 390MB of someone else's dataset.
#   research/experiments/H1-A9-A12-SHARED-01/source-only-v1/inference-input-manifest.json
#   research/experiments/H1-W6-SAME-INTELLIGENCE-01/receipts/holdout-manifest-v8.json
research/experiments/H1-A9-A12-SHARED-01/source-only-v1/inputs/
research/experiments/H1-A9-A12-SHARED-01/source-only-v1/source-only-48.tar
# Only the two 50MB corpora are excluded. corpus-v5 / corpus-v6 (88KB each) and
# corpus-v8-holdout-failed-20260820T0548Z (184KB) are committed: the first two
# are small enough to carry, and the third is a failed-experiment artifact,
# which the evidence rule says is preserved rather than tidied away.
research/experiments/H1-W6-SAME-INTELLIGENCE-01/corpus-v7/
research/experiments/H1-W6-SAME-INTELLIGENCE-01/corpus-v8-holdout/

# File lists produced by the 2026-08-27 commit-batching pass. The commits they
# drove are in history; the lists themselves are scratch and are kept on disk
# only so the pass can be re-read if a grouping is ever questioned.
/_core_commit_closure.txt
/_research_commit_list.txt
